/* ============================================================
   BRITISH MIDLAND VIRTUAL
   OPERATIONS CONTROL - REVIEW CENTRE
   ============================================================ */


/* ------------------------------------------------------------
   INTRODUCTION
   ------------------------------------------------------------ */

.reviews-intro {
    padding: 48px 0 34px;

    display: flex;
    align-items: flex-end;
    justify-content: space-between;

    gap: 30px;
}


.reviews-intro .eyebrow {
    display: block;

    margin-bottom: 12px;

    color: #d02823;

    font-size: 9px;
    font-weight: 700;

    letter-spacing: 0.2em;
}


.reviews-intro h2 {
    margin: 0 0 10px;

    color: #001a3a;

    font-size: 36px;
    line-height: 1.05;

    letter-spacing: -0.04em;
}


.reviews-intro p {
    margin: 0;

    color: #66717c;

    font-size: 11px;
    line-height: 1.6;
}


/* ------------------------------------------------------------
   SYSTEM STATUS
   ------------------------------------------------------------ */

.review-system-status {
    display: flex;
    align-items: center;

    gap: 11px;
}


.review-system-status .status-dot {
    width: 10px;
    height: 10px;

    flex-shrink: 0;

    border-radius: 50%;

    background: #15965e;

    box-shadow:
        0 0 0 5px rgba(21, 150, 94, 0.08);
}


.review-system-status div {
    display: flex;
    flex-direction: column;

    gap: 3px;
}


.review-system-status strong {
    color: #001a3a;

    font-size: 8px;
    font-weight: 700;

    letter-spacing: 0.1em;
}


.review-system-status small {
    color: #15965e;

    font-size: 7px;
    font-weight: 700;

    letter-spacing: 0.08em;
}


/* ------------------------------------------------------------
   REVIEW STATISTICS
   ------------------------------------------------------------ */

.review-stats-grid {
    margin-bottom: 18px;
}


.review-stat-card {
    border-top-color: #d02823 !important;
}


.review-stat-card > strong {
    color: #d02823;
}


/* ------------------------------------------------------------
   REVIEW QUEUE PANEL
   ------------------------------------------------------------ */

.review-queue-panel {
    margin-bottom: 30px;

    overflow: hidden;
}


.review-queue-header {
    padding: 24px 26px;

    display: flex;
    align-items: flex-end;
    justify-content: space-between;

    gap: 30px;

    border-bottom: 1px solid #e5e5e5;
}


.review-queue-header h3 {
    margin: 6px 0 7px;

    color: #001a3a;

    font-size: 18px;
}


.review-queue-header p {
    margin: 0;

    color: #7d8791;

    font-size: 9px;
    line-height: 1.5;
}


/* ------------------------------------------------------------
   SEARCH
   ------------------------------------------------------------ */

.review-search-wrap {
    width: 230px;

    display: flex;
    flex-direction: column;

    gap: 7px;
}


.review-search-wrap label {
    color: #87919b;

    font-size: 7px;
    font-weight: 700;

    letter-spacing: 0.14em;
}


.review-search-wrap input {
    width: 100%;

    padding: 11px 13px;

    border: 1px solid #d9dde0;

    outline: none;

    background: #ffffff;

    color: #001a3a;

    font-family: "Inter", sans-serif;
    font-size: 10px;

    transition:
        border-color 0.15s ease,
        box-shadow 0.15s ease;
}


.review-search-wrap input:focus {
    border-color: #001a3a;

    box-shadow:
        0 0 0 2px rgba(0, 26, 58, 0.05);
}


.review-search-wrap input::placeholder {
    color: #a0a8af;
}


/* ------------------------------------------------------------
   REVIEW TABLE
   ------------------------------------------------------------ */

.review-table-wrap {
    width: 100%;

    overflow-x: auto;
}


.review-table-header,
.review-row {
    display: grid;

    grid-template-columns:
        minmax(150px, 1.2fr)
        minmax(85px, 0.7fr)
        minmax(125px, 1fr)
        minmax(120px, 1fr)
        minmax(85px, 0.7fr)
        minmax(75px, 0.6fr)
        minmax(110px, 0.8fr);

    align-items: center;
}


.review-table-header {
    min-width: 850px;

    padding: 15px 22px;

    background: #fafafa;

    border-bottom: 1px solid #eeeeee;
}


.review-table-header span {
    color: #87919b;

    font-size: 7px;
    font-weight: 700;

    letter-spacing: 0.13em;
}


.review-table-body {
    min-width: 850px;
}


/* ------------------------------------------------------------
   REVIEW ROW
   ------------------------------------------------------------ */

.review-row {
    min-height: 72px;

    padding: 0 22px;

    border-bottom: 1px solid #eeeeee;

    background: #ffffff;

    cursor: pointer;

    transition:
        background 0.15s ease,
        border-left-color 0.15s ease;
}


.review-row:last-child {
    border-bottom: 0;
}


.review-row:hover {
    background: #fff9f8;
}


.review-row > div {
    padding-right: 12px;
}


.review-pilot {
    display: flex;
    flex-direction: column;

    gap: 5px;
}


.review-pilot strong {
    color: #001a3a;

    font-size: 11px;
}


.review-pilot span {
    color: #8a939d;

    font-size: 7px;
    font-weight: 700;

    letter-spacing: 0.09em;
}


.review-flight,
.review-route,
.review-aircraft,
.review-landing,
.review-score {
    color: #001a3a;

    font-size: 10px;
    font-weight: 600;
}


.review-route {
    letter-spacing: 0.04em;
}


.review-landing.hard {
    color: #d02823;
}


.review-landing.good {
    color: #168652;
}


/* ------------------------------------------------------------
   REVIEW STATUS BADGE
   ------------------------------------------------------------ */

.review-status {
    display: inline-flex;
    align-items: center;

    width: fit-content;

    padding: 6px 8px;

    background: #fff1ef;

    color: #d02823;

    font-size: 7px;
    font-weight: 700;

    letter-spacing: 0.08em;
}


/* ------------------------------------------------------------
   LOADING / EMPTY
   ------------------------------------------------------------ */

.review-loading,
.review-empty {
    min-height: 190px;

    display: flex;
    align-items: center;
    justify-content: center;

    padding: 30px;

    color: #87919b;

    font-size: 10px;

    text-align: center;
}


.review-empty {
    flex-direction: column;

    gap: 10px;
}


.review-empty-mark {
    width: 38px;
    height: 3px;

    margin-bottom: 5px;

    background: #15965e;
}


.review-empty strong {
    color: #001a3a;

    font-size: 13px;
}


.review-empty span {
    color: #87919b;

    font-size: 9px;
}


/* ------------------------------------------------------------
   ERROR
   ------------------------------------------------------------ */

.review-error {
    margin-bottom: 30px;

    padding: 18px 20px;

    border-left: 3px solid #d02823;

    background: #fff5f4;

    color: #a82723;

    font-size: 11px;
}


.review-error.hidden {
    display: none;
}


/* ------------------------------------------------------------
   RESPONSIVE
   ------------------------------------------------------------ */

@media (max-width: 900px) {

    .reviews-intro {
        align-items: flex-start;
        flex-direction: column;
    }


    .review-queue-header {
        align-items: flex-start;
        flex-direction: column;
    }


    .review-search-wrap {
        width: 100%;
    }

}


@media (max-width: 600px) {

    .reviews-intro {
        padding-top: 32px;
    }


    .reviews-intro h2 {
        font-size: 30px;
    }


    .review-queue-header {
        padding: 20px;
    }

}
